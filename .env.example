# Copiá este archivo a ".env" para desarrollo local (npm run dev lo carga solo).
# En Railway se configuran como variables del servicio (ver README).

# Postgres. Local: el que levanta "npm run dev:db". Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/relator

# Obligatorio en producción: string largo y aleatorio (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambiame-por-un-secreto-largo

# Puerto del API en desarrollo (el frontend de Vite lo usa como proxy). En Railway se usa PORT automáticamente.
API_PORT=3001

# Opcional: clave para cifrar las API keys de los usuarios (por defecto deriva de JWT_SECRET)
# APP_SECRET=

# Opcional: API key global de API-Football (cada relator puede cargar la suya en Ajustes)
# API_FOOTBALL_KEY=

# Opcional: si se define, el registro exige este código de invitación
# REGISTRATION_CODE=

# Solo si te conectás a Postgres por la URL pública de Railway (requiere SSL)
# PGSSL=true
